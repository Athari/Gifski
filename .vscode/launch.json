{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Gifski (input.mov)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [ "build", "--bin=gifski", "--features", "video" ],
            },
            "args": [
                "--output", "${workspaceFolder}/tmp/output.gif",
                "--quality", "100",
                "--motion-quality", "100",
                "--lossy-quality", "100",
                "--width", "112",
                "--height", "112",
                "--extra",
                "--global-palette",
                "${workspaceFolder}/tmp/input.mov",
            ],
            "env": {
                "PATH": "${workspaceFolder}/vendor/ffmpeg/bin;${env:PATH}"
            },
            "cwd": "${workspaceFolder}",
        }
    ]
}